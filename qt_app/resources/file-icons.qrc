<RCC>
    <qresource prefix="/file-icons">
        <file alias="pdf.png">file-icons/pdf.png</file>
        <file alias="md.png">file-icons/md.png</file>
        <file alias="docx.png">file-icons/docx.png</file>
        <file alias="xlsx.png">file-icons/xlsx.png</file>
        <file alias="pptx.png">file-icons/pptx.png</file>
        <file alias="txt.png">file-icons/txt.png</file>
        <file alias="photo.png">file-icons/photo.png</file>
        <file alias="genericfile.png">file-icons/genericfile.png</file>
    </qresource>
    <qresource prefix="/branding">
        <file alias="app_icon.png">branding/app_icon.png</file>
        <!-- Rasterized at 3x from entry/src/main/resources/base/media/harmonyos_logo.svg. -->
        <file alias="harmonyos_logo.png">branding/harmonyos_logo.png</file>
    </qresource>
    <qresource prefix="/window-controls">
        <file alias="minimize.svg">window-controls/minimize.svg</file>
        <file alias="maximize.svg">window-controls/maximize.svg</file>
        <file alias="recover.svg">window-controls/recover.svg</file>
        <file alias="close.svg">window-controls/close.svg</file>
    </qresource>
</RCC>
